DATABASE_URL=postgresql://postgres:pwd@localhost:5432/pln_geomatch
APP_ENV=development
# Local HTTP only. For production: APP_ENV=production, HTTPS, and true.
AUTH_COOKIE_SECURE=false
AUTH_IDLE_MINUTES=30
AUTH_ABSOLUTE_HOURS=8
CORS_ALLOWED_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
# Test/reset/seed routes are disabled by default and forbidden in production.
ALLOW_TEST_DATA_TOOLS=false
REDIS_URL=redis://localhost:6379/0
# Aktifkan untuk pengembangan lokal tanpa Redis/Celery.
ALLOW_SYNC_FALLBACK=false
