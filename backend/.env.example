# --- KONFIGURASI DATABASE (DARI SUPABASE) ---
# Dapatkan di: Settings -> Database -> Connection string -> URI
# Ganti [YOUR-PASSWORD] dengan password database Supabase Anda.
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@aws-0-eu-west-1.pooler.supabase.com:6543/postgres

# --- KONFIGURASI KEAMANAN JWT (DARI SUPABASE) ---
# Dapatkan di: Settings -> API -> JWT Settings -> JWT Secret
# Ini digunakan untuk memverifikasi token yang dikirim dari Frontend.
SUPABASE_JWT_SECRET=your-supabase-jwt-secret-here

# --- KONFIGURASI URL (DARI SUPABASE) ---
# Dapatkan di: Settings -> API -> API Settings -> Project URL
SUPABASE_URL=https://your-project-ref.supabase.co

# --- PENGATURAN FASTAPI ---
# Tetap gunakan HS256 (default Supabase)
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480
ALLOW_SYNC_FALLBACK=true
