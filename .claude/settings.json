{
  "enabledPlugins": {
    "agent-skills@addy-agent-skills": true,
    "supermemory@supermemory-plugins": true,
    "gsap-skills@gsap-skills": true,
    "supabase@claude-plugins-official": true,
    "supabase-expert@anthropic-plugin-directory": true,
    "testerarmy@testerarmy-agent-skills": true,
    "context7@claude-plugins-official": true,
    "remember@claude-plugins-official": true,
    "chrome-devtools-mcp@chrome-devtools-plugins": true
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "C:/Users/advan/.local/bin/graphify.EXE hook-guard search",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Read|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "C:/Users/advan/.local/bin/graphify.EXE hook-guard read",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "C:/Users/advan/.local/bin/graphify.EXE hook-guard compact",
            "timeout": 10
          }
        ]
      }
    ]
  }
}